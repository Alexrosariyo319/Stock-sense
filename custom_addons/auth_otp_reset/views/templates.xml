<odoo>

    <template id="otp_request_page" name="Request OTP">
        <html>
            <head><title>Forgot Password</title></head>
            <body style="font-family: Arial, sans-serif; max-width: 400px; margin: 60px auto;">
                <h2>Forgot Password</h2>
                <p>Enter your email to receive a one-time password.</p>
                <t t-if="error">
                    <div style="color: red;" t-esc="error"/>
                </t>
                <form action="/auth/otp/request" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <label>Email</label><br/>
                    <input type="text" name="login" style="width:100%; padding:8px; margin-bottom:12px;" required="required"/><br/>
                    <button type="submit" style="padding:8px 16px;">Send OTP</button>
                </form>
            </body>
        </html>
    </template>

    <template id="otp_verify_page" name="Verify OTP">
        <html>
            <head><title>Enter OTP</title></head>
            <body style="font-family: Arial, sans-serif; max-width: 400px; margin: 60px auto;">
                <h2>Enter Your Code</h2>
                <p>We sent a 6-digit code to your email. It expires in 10 minutes.</p>
                <t t-if="error">
                    <div style="color: red;" t-esc="error"/>
                </t>
                <form action="/auth/otp/verify" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="login" t-att-value="login"/>
                    <label>OTP Code</label><br/>
                    <input type="text" name="code" style="width:100%; padding:8px; margin-bottom:12px;" required="required"/><br/>
                    <label>New Password</label><br/>
                    <input type="password" name="new_password" style="width:100%; padding:8px; margin-bottom:12px;" required="required"/><br/>
                    <button type="submit" style="padding:8px 16px;">Reset Password</button>
                </form>
            </body>
        </html>
    </template>

    <template id="otp_success_page" name="OTP Success">
        <html>
            <head><title>Success</title></head>
            <body style="font-family: Arial, sans-serif; max-width: 400px; margin: 60px auto;">
                <h2>Password Reset Successful</h2>
                <p>You can now <a href="/web/login">log in</a> with your new password.</p>
            </body>
        </html>
    </template>

</odoo>
